{
  "expo": {
    "name": "What's for Dinner",
    "slug": "whats-for-dinner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#EEF4FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simsimeduai.whatsfordinner",
      "infoPlist": {
        "NSCameraUsageDescription": "What's for Dinner uses the camera to snap photos of grocery receipts.",
        "NSPhotoLibraryUsageDescription": "What's for Dinner accesses Photos so you can pick receipt images."
      }
    },
    "android": {
      "package": "com.simsimeduai.whatsfordinner",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
